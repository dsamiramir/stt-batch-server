# Copy to .env and edit. Every key is optional; defaults are in app/config.py.

# --- network ---------------------------------------------------------------
STT_HOST=0.0.0.0
STT_PORT=8760
# Leave empty to disable auth (fine on a trusted LAN). If set, clients send
# either "X-API-Key: <key>" or "Authorization: Bearer <key>".
STT_API_KEY=
STT_MAX_UPLOAD_MB=4096
# Resubmitting a client_ref that is already queued, running or done returns
# that job instead of queuing the same audio again. force=true overrides.
STT_DEDUPE_CLIENT_REF=true

# --- model -----------------------------------------------------------------
STT_MODEL_SIZE=large-v3
STT_DEVICE=auto
STT_COMPUTE_TYPE=auto
# Drop the model and free VRAM after this many idle seconds (0 = never).
STT_MODEL_IDLE_UNLOAD_SEC=900
# STT_MODEL_DOWNLOAD_ROOT=D:/models/whisper

# --- transcription defaults ------------------------------------------------
STT_LANGUAGE=ko
STT_BEAM_SIZE=5
STT_VAD_FILTER=true
STT_WORD_TIMESTAMPS=true
STT_CONDITION_ON_PREVIOUS_TEXT=false
# 자꾸 오인식되는 고유명사만, 짧게. 잡이 보낸 목록과 합집합으로 쓰인다.
# 이 값은 디코더의 "직전 텍스트" 자리에 들어가므로 길면 발화로 베껴진다.
# STT_HOTWORDS=당근알바
# 모델은 이 프롬프트의 문체를 모방한다. 구두점이 든 짧은 한 줄은 출력의
# 마침표·쉼표를 되살리지만, 그 문장이 발화로 베껴지기도 한다. 켜기 전에
# scripts/transcript_metrics.py로 전후를 비교할 것.
# STT_INITIAL_PROMPT=네, 고객님. 확인해 드리겠습니다.

# --- VAD -------------------------------------------------------------------
# 발화 조각을 끊는 무음 길이. 내리면 한국어 대화가 문장 중간에서 잘려
# 조각마다 문맥이 끊기고 구두점이 사라진다. faster-whisper 기본값은 2000.
STT_VAD_MIN_SILENCE_MS=2000
STT_VAD_SPEECH_PAD_MS=400
STT_VAD_MAX_SPEECH_SEC=30

# --- multi-channel ---------------------------------------------------------
STT_MAX_CHANNELS=8
# Positional labels for channels 0,1,2...
STT_CHANNEL_NAMES=agent,customer
STT_SKIP_SILENT_CHANNELS=true

# --- off-peak scheduling ---------------------------------------------------
STT_SCHEDULE_ENABLED=true
# "<days> <HH:MM>-<HH:MM>", ";"-separated. End <= start wraps past midnight.
STT_WINDOWS=Mon-Fri 22:00-08:00; Sat 00:00-24:00; Sun 00:00-24:00

STT_GPU_IDLE_CHECK=true
STT_GPU_INDEX=0
STT_GPU_MAX_UTIL=25
STT_GPU_MIN_FREE_MB=6000

# --- audio retention -------------------------------------------------------
# Delete the uploaded audio as soon as its transcript exists. Results in
# data/results/ are never touched.
STT_DELETE_AUDIO_ON_SUCCESS=true
# Audio for jobs that never finished (queued, failed, canceled) is kept this
# long, then deleted. 0 keeps it forever.
STT_AUDIO_RETENTION_DAYS=3
# How often the sweep runs, in seconds. 0 disables the periodic sweep.
STT_CLEANUP_INTERVAL_SEC=3600

# Keep going on a job that started in-window even after the window closes.
STT_FINISH_JOB_OUTSIDE_WINDOW=true
STT_POLL_INTERVAL_SEC=5
STT_MAX_ATTEMPTS=2
